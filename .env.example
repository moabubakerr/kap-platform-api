# Copy to .env and fill in. Never commit .env.
PLATFORM_DB_PASSWORD=change-me

# Bearer keys the console uses to call the platform API (comma-separated JSON list)
PLATFORM_API_KEYS=["change-me-console-key"]

# Shared secret KAP sends back on job callbacks (callback_headers)
PLATFORM_HOOK_TOKEN=change-me-hook-token

# Model gateway: default upstream for KAP model providers; per-provider overrides as JSON
PLATFORM_GATEWAY_DEFAULT_UPSTREAM=http://sceai-stand-vllm:8000
PLATFORM_GATEWAY_UPSTREAMS={"embed_default": "http://sceai-stand-ollama:11434"}

# KAP credentials referenced from config/tenants.yaml
KAP_TOKEN_SANDBOX=
# KAP_M2M_SECRET_SCEAI=
