# Copy to .env and fill in. Never commit .env.
PLATFORM_DB_PASSWORD=change-me

# Bearer keys the console uses to call the platform API (comma-separated JSON list)
PLATFORM_API_KEYS=["change-me-console-key"]

# Shared secret KAP sends back on job callbacks (callback_headers)
PLATFORM_HOOK_TOKEN=change-me-hook-token

# Model gateway: default upstream for KAP model providers; per-provider overrides as JSON
PLATFORM_GATEWAY_DEFAULT_UPSTREAM=http://sceai-stand-vllm:8000
PLATFORM_GATEWAY_UPSTREAMS={"embed_default": "http://sceai-stand-ollama:11434"}

# KAP credentials referenced from config/tenants.yaml
KAP_TOKEN_SANDBOX=
# KAP_M2M_SECRET_SCEAI=

# ---- PostgreSQL data source (export customer tables to KAP indicator CSVs on S3)
# Encrypts stored source passwords (Fernet: urlsafe base64 of 32 random bytes). Generate one:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   or: openssl rand -base64 32 | tr '+/' '-_'
# Keep it stable: changing it makes stored passwords unreadable (re-enter them in the console).
PLATFORM_SECRET_KEY=

# S3-compatible store KAP's connectors read (RustFS on the stand). Path addressing, bucket created if missing.
PLATFORM_S3_URL=http://s3:9000
PLATFORM_S3_ACCESS_KEY=
PLATFORM_S3_SECRET_KEY=
PLATFORM_S3_BUCKET=platform-exports
# Endpoint as KAP sees it, if different from PLATFORM_S3_URL (the keys above are given to KAP's connector)
# PLATFORM_S3_KAP_URL=http://s3:9000
